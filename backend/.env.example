# Backend-Konfiguration (kopieren nach .env und anpassen)

# App
APP_NAME="Heart & Match Backend"
ENVIRONMENT=development
CONTENT_TIER=sfw            # sfw | adult (nur Metadaten/Defaults)

# Auth — in Produktion zwingend ändern!
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=43200

# Datenbank (SQLite default; für Produktion z.B. PostgreSQL)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/heartmatch
# DATABASE_URL=sqlite:///./heartmatch.db

# ComfyUI (eigene Instanz; das Backend liefert KEINE Modelle)
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SECONDS=180
COMFYUI_POLL_INTERVAL_SECONDS=1.0
COMFYUI_MAX_QUEUE=8

# Cache für generierte Bilder
CACHE_DIR=./generated_cache
